# Copy to .env and adjust
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=indoorgamingarena

# Optional: if set, every write (POST/PUT/PATCH/DELETE) must send header  x-api-key: <value>
# The web UI will ask for it once. Strongly recommended for any public deployment.
API_KEY=

# Arena opening hours (24h clock) used to validate bookings
OPEN_HOUR=10
CLOSE_HOUR=23
